{
  "name": "@nexora/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build && node -e \"require('fs').writeFileSync('dist/main.js', 'require(\\\"./src/main.js\\\");\\n')\"",
    "start": "node dist/src/main.js",
    "lint": "eslint src/ && tsc --noEmit",
    "test": "vitest run --config ./vitest.config.mts src/**/*.spec.ts",
    "test:unit": "vitest run --config ./vitest.config.mts src/**/*.spec.ts",
    "test:e2e": "tsx test/run-e2e.ts",
    "test:browser": "tsx test/run-e2e.ts browser",
    "prisma:generate": "if [ -z \"$DATABASE_URL\" ] && [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; prisma generate",
    "prisma:migrate": "if [ -z \"$DATABASE_URL\" ] && [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; prisma migrate deploy",
    "prisma:status": "if [ -z \"$DATABASE_URL\" ] && [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; prisma migrate status",
    "prisma:seed": "if [ -z \"$DATABASE_URL\" ] && [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/platform-socket.io": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "18.0.3",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^4.1.12"
  }
}

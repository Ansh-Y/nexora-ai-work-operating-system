generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  AT_RISK
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum DependencyType {
  BLOCKS
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  EXPIRED
}

enum GitHubAutomationTrigger {
  PULL_REQUEST_OPENED
  PULL_REQUEST_UPDATED
  PULL_REQUEST_APPROVED
  PULL_REQUEST_MERGED
  PULL_REQUEST_CLOSED
  ISSUE_OPENED
  ISSUE_CLOSED
  COMMIT_PUSHED
}

enum GitHubAutomationAction {
  TRANSITION_TASK_STATUS
  ADD_COMMENT
}

enum GitHubAutomationExecutionMode {
  AUTOMATIC
  APPROVAL_REQUIRED
}

enum GitHubAutomationRunStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  SKIPPED
}

enum WorkflowTriggerType {
  TASK_OVERDUE
  TASK_STATUS_CHANGED
  TASK_MARKED_BLOCKED
  PROJECT_HEALTH_AT_RISK
  MILESTONE_APPROACHING
  TASK_CREATED
}

enum WorkflowActionType {
  AI_TASK_RECOMMENDATION
  RECOMMEND_TASK_ASSIGNEE
  NOTIFY_PROJECT_MANAGER
  GENERATE_HEALTH_SUMMARY
  CREATE_TASK_PROPOSAL
}

enum WorkflowRunStatus {
  PENDING_APPROVAL
  APPROVED
  EXECUTED
  REJECTED
  FAILED
}

enum StorageUploadStatus {
  PENDING
  READY
  FAILED
}

enum RetentionHoldType {
  LEGAL
  OPERATIONAL
  COMPLIANCE
}

enum ActorType {
  USER
  AI
  SYSTEM
}

enum NotificationType {
  ASSIGNMENT
  COMMENT
  MENTION
  DEADLINE
  RISK
  MILESTONE
}

enum MeetingStatus {
  SCHEDULED
  PROCESSING
  READY
  FAILED
}

enum MeetingProcessingState {
  NOT_STARTED
  AWAITING_CONFIGURATION
  QUEUED
  TRANSCRIBING
  ANALYZING
  COMPLETE
  FAILED
}

enum MeetingActionStatus {
  EXTRACTED
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
}

model User {
  id                        String               @id @default(uuid()) @db.Uuid
  email                     String               @unique
  name                      String
  passwordHash              String
  emailVerifiedAt           DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  memberships               Membership[]
  ownedProjects             Project[]            @relation("ProjectOwner")
  assignedTasks             Task[]               @relation("TaskAssignee")
  comments                  Comment[]
  auditEvents               AuditEvent[]         @relation("AuditActor")
  notifications             Notification[]
  proposals                 AiProposal[]         @relation("ProposalCreator")
  refreshSessions           RefreshSession[]
  createdMeetings           Meeting[]            @relation("MeetingCreator")
  meetingParticipants       MeetingParticipant[]
  assignedMeetingActions    MeetingActionItem[]  @relation("MeetingActionAssignee")
  approvedMeetingActions    MeetingActionItem[]  @relation("MeetingActionApprover")
  uploadedMeetingRecordings MeetingRecording[]   @relation("MeetingRecordingUploader")
  githubConnections         GitHubConnection[]   @relation("GitHubConnectionOwner")
  githubOAuthStates         GitHubOAuthState[]
  createdGitHubRules        GitHubAutomationRule[] @relation("GitHubRuleCreator")
  updatedGitHubRules        GitHubAutomationRule[] @relation("GitHubRuleUpdater")
  reviewedGitHubRuns        GitHubAutomationRun[]  @relation("GitHubRunReviewer")
  createdWorkflowRules      WorkflowAutomationRule[] @relation("WorkflowRuleCreator")
  updatedWorkflowRules      WorkflowAutomationRule[] @relation("WorkflowRuleUpdater")
  reviewedWorkflowRuns      WorkflowAutomationRun[]  @relation("WorkflowRunReviewer")
  appliedHolds              FileRetentionHold[]    @relation("HoldApplier")
  releasedHolds             FileRetentionHold[]    @relation("HoldReleaser")
  googleConnections         GoogleConnection[]   @relation("GoogleConnectionOwner")
  googleOAuthStates         GoogleOAuthState[]
  dismissedRisks            ProjectRisk[]        @relation("RiskDismissedBy")
  createdWeeklyReports      ProjectWeeklyReport[] @relation("ReportCreator")
}

model Organization {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  projects            Project[]
  milestones          Milestone[]
  tasks               Task[]
  dependencies        TaskDependency[]
  comments            Comment[]
  meetings            Meeting[]
  meetingRecordings   MeetingRecording[]
  meetingParticipants MeetingParticipant[]
  transcriptSegments  TranscriptSegment[]
  meetingDecisions    MeetingDecision[]
  meetingActionItems  MeetingActionItem[]
  documents           Document[]
  notifications       Notification[]
  proposals           AiProposal[]
  auditEvents         AuditEvent[]
  integrations        Integration[]
  githubConnections   GitHubConnection[]
  githubOAuthStates   GitHubOAuthState[]
  githubRepositories  GitHubRepository[]
  githubEvents        GitHubEvent[]
  searchChunks        SearchChunk[]
  invites             Invitation[]
  refreshSessions     RefreshSession[]
  gitHubAutomationRules GitHubAutomationRule[]
  gitHubAutomationRuns  GitHubAutomationRun[]
  workflowAutomationRules WorkflowAutomationRule[]
  workflowAutomationRuns  WorkflowAutomationRun[]
  storageObjects        StorageObject[]
  retentionPolicy       OrganizationRetentionPolicy?
  fileRetentionHolds    FileRetentionHold[]
  googleConnection      GoogleConnection?
  googleOAuthStates     GoogleOAuthState[]
  googleCalendarEvents  GoogleCalendarEvent[]
  gmailMessages         GmailMessage[]
  projectHealthSnapshots ProjectHealthSnapshot[]
  projectRisks           ProjectRisk[]
  projectWeeklyReports   ProjectWeeklyReport[]
}

model RefreshSession {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, expiresAt])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(TEAM_MEMBER)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  role           OrganizationRole @default(TEAM_MEMBER)
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Project {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  ownerId            String              @db.Uuid
  name               String
  description        String              @default("")
  status             ProjectStatus       @default(PLANNING)
  priority           Priority            @default(MEDIUM)
  startDate          DateTime?
  dueDate            DateTime?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User                @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks              Task[]
  milestones         Milestone[]
  comments           Comment[]
  meetingActionItems MeetingActionItem[]
  meetings           Meeting[]
  githubRepositories GitHubRepository[]
  documents          Document[]
  gitHubAutomationRules GitHubAutomationRule[]
  workflowAutomationRules WorkflowAutomationRule[]
  workflowAutomationRuns  WorkflowAutomationRun[]
  googleCalendarEvents    GoogleCalendarEvent[]
  suggestedCalendarEvents GoogleCalendarEvent[] @relation("SuggestedCalendarProject")
  gmailMessages           GmailMessage[]
  suggestedGmailMessages  GmailMessage[]        @relation("SuggestedGmailProject")
  healthSnapshots         ProjectHealthSnapshot[]
  risks                   ProjectRisk[]
  weeklyReports           ProjectWeeklyReport[]

  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
}

model Task {
  id                       String             @id @default(uuid()) @db.Uuid
  organizationId           String             @db.Uuid
  projectId                String             @db.Uuid
  assigneeId               String?            @db.Uuid
  title                    String
  description              String             @default("")
  status                   TaskStatus         @default(TODO)
  priority                 Priority           @default(MEDIUM)
  startDate                DateTime?
  dueDate                  DateTime?
  completedAt              DateTime?
  labels                   String[]           @default([])
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee                 User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  blockedBy                TaskDependency[]   @relation("BlockedTask")
  blocks                   TaskDependency[]   @relation("BlockingTask")
  comments                 Comment[]
  originatingMeetingAction MeetingActionItem?
  githubEvents             GitHubEvent[]
  gitHubAutomationRules    GitHubAutomationRule[]
  gitHubAutomationRuns     GitHubAutomationRun[]
  workflowAutomationRuns   WorkflowAutomationRun[]

  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, dueDate])
}

model Milestone {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String       @db.Uuid
  title          String
  description    String       @default("")
  targetDate     DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, targetDate])
}

model TaskDependency {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  blockingTaskId String         @db.Uuid
  blockedTaskId  String         @db.Uuid
  type           DependencyType @default(BLOCKS)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blockingTask   Task           @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask    Task           @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
  @@index([organizationId, blockingTaskId])
  @@index([organizationId, blockedTaskId])
}

model Comment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String?      @db.Uuid
  taskId         String?      @db.Uuid
  authorId       String       @db.Uuid
  body           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])

  @@index([organizationId, createdAt])
}

model Meeting {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  projectId           String?                @db.Uuid
  createdById         String?                @db.Uuid
  title               String
  description         String                 @default("")
  startsAt            DateTime?
  durationMinutes     Int?
  status              MeetingStatus          @default(SCHEDULED)
  processingState     MeetingProcessingState @default(NOT_STARTED)
  processingError     String?
  archivedAt          DateTime?
  audioUrl            String?
  transcript          String?
  summary             String?
  summaryEvidence     Json?
  analysisRecordingId String?                @db.Uuid
  objectives          Json?
  discussionTopics    Json?
  risks               Json?
  unresolvedQuestions Json?
  decisions           Json?
  actionItems         Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy           User?                  @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants        MeetingParticipant[]
  recordings          MeetingRecording[]
  segments            TranscriptSegment[]
  decisionsEvidence   MeetingDecision[]
  actionItemsReview   MeetingActionItem[]
  googleCalendarEvents GoogleCalendarEvent[] @relation("GoogleMeetingLink")

  @@index([organizationId, startsAt])
  @@index([organizationId, archivedAt, startsAt])
}

model MeetingParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  meetingId      String       @db.Uuid
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting        Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([organizationId, userId])
}

model MeetingRecording {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @db.Uuid
  meetingId             String                 @db.Uuid
  uploadedById          String?                @db.Uuid
  storageObjectId       String?                @unique @db.Uuid
  storageKey            String                 @unique
  fileName              String
  mimeType              String
  sizeBytes             Int
  sha256                String
  version               Int                    @default(1)
  processingState       MeetingProcessingState @default(NOT_STARTED)
  processingError       String?
  processingGeneration  Int                    @default(0)
  transcriptionProvider String?
  transcript            String?
  createdAt             DateTime               @default(now())
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting               Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy            User?                  @relation("MeetingRecordingUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  storageObject         StorageObject?         @relation("RecordingStorageObject", fields: [storageObjectId], references: [id], onDelete: SetNull)
  segments              TranscriptSegment[]
  decisions             MeetingDecision[]
  actionItems           MeetingActionItem[]

  @@unique([meetingId, version])
  @@index([organizationId, meetingId, createdAt])
}

model TranscriptSegment {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  meetingId      String            @db.Uuid
  recordingId    String?           @db.Uuid
  sequence       Int
  startMs        Int?
  endMs          Int?
  speakerLabel   String?
  text           String
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting        Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recording      MeetingRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@unique([meetingId, sequence])
  @@index([organizationId, meetingId, startMs])
}

model MeetingDecision {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  meetingId      String            @db.Uuid
  sequence       Int
  recordingId    String?           @db.Uuid
  title          String
  evidence       String
  timestampMs    Int?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting        Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recording      MeetingRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@unique([meetingId, sequence])
  @@index([organizationId, meetingId])
}

model MeetingActionItem {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  meetingId      String              @db.Uuid
  projectId      String?             @db.Uuid
  assigneeId     String?             @db.Uuid
  approvedById   String?             @db.Uuid
  createdTaskId  String?             @unique @db.Uuid
  recordingId    String?             @db.Uuid
  sequence       Int
  title          String
  description    String              @default("")
  evidence       String
  timestampMs    Int?
  suggestedOwner String?
  dueDate        DateTime?
  status         MeetingActionStatus @default(EXTRACTED)
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting        Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee       User?               @relation("MeetingActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  approvedBy     User?               @relation("MeetingActionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdTask    Task?               @relation(fields: [createdTaskId], references: [id], onDelete: SetNull)
  recording      MeetingRecording?   @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@unique([meetingId, sequence])
  @@index([organizationId, meetingId, status])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, projectId])
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  projectId       String?        @db.Uuid
  storageObjectId String?        @unique @db.Uuid
  title           String
  mimeType        String
  storageKey      String
  extractedText   String?
  createdAt       DateTime       @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  storageObject   StorageObject? @relation("DocumentStorageObject", fields: [storageObjectId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId])
}

model SearchChunk {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  sourceType     String
  sourceId       String                       @db.Uuid
  content        String
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceType, sourceId])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String
  readAt         DateTime?
  dedupeKey      String?          @unique
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
}

model AiProposal {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  creatorId      String         @db.Uuid
  kind           String
  status         ProposalStatus @default(PENDING)
  title          String
  input          Json
  proposed       Json
  explanation    String         @default("")
  approvedById   String?        @db.Uuid
  executedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User           @relation("ProposalCreator", fields: [creatorId], references: [id])

  @@index([organizationId, status, createdAt])
}

model Integration {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  provider       String
  status         String       @default("NOT_CONFIGURED")
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model GitHubConnection {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @unique @db.Uuid
  connectedById   String             @db.Uuid
  githubUserId    String
  githubLogin     String
  tokenCiphertext String
  scopes          String[]           @default([])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy     User               @relation("GitHubConnectionOwner", fields: [connectedById], references: [id])
  repositories    GitHubRepository[]
}

model GitHubOAuthState {
  stateHash      String       @id
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([organizationId, userId, createdAt])
}

model GitHubRepository {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @db.Uuid
  connectionId            String           @db.Uuid
  projectId               String           @db.Uuid
  githubRepoId            BigInt
  owner                   String
  name                    String
  fullName                String
  defaultBranch           String?
  isPrivate               Boolean          @default(false)
  webhookSecretCiphertext String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection              GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events                  GitHubEvent[]
  automationRules         GitHubAutomationRule[]

  @@unique([organizationId, githubRepoId])
  @@index([organizationId, projectId])
}

model GitHubEvent {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  repositoryId     String           @db.Uuid
  githubDeliveryId String
  eventType        String
  action           String?
  number           Int?
  title            String?
  url              String?
  summary          String?
  branch           String?
  commitSha        String?
  linkedTaskId     String?          @db.Uuid
  occurredAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository       GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  linkedTask       Task?            @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  automationRuns   GitHubAutomationRun[]

  @@unique([repositoryId, githubDeliveryId])
  @@index([organizationId, createdAt])
  @@index([organizationId, linkedTaskId])
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorType      ActorType
  actorId        String?      @db.Uuid
  action         String
  targetType     String
  targetId       String?
  metadata       Json         @default("{}")
  requestId      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, targetType, targetId])
}

model GitHubAutomationRule {
  id                  String                        @id @default(uuid()) @db.Uuid
  organizationId      String                        @db.Uuid
  repositoryId        String?                       @db.Uuid
  projectId           String?                       @db.Uuid
  taskId              String?                       @db.Uuid
  name                String
  description         String                        @default("")
  triggerEvent        GitHubAutomationTrigger
  action              GitHubAutomationAction        @default(TRANSITION_TASK_STATUS)
  targetStatus        TaskStatus?
  executionMode       GitHubAutomationExecutionMode @default(AUTOMATIC)
  conditions          Json                          @default("{}")
  isEnabled           Boolean                       @default(true)
  createdById         String                        @db.Uuid
  updatedById         String?                       @db.Uuid
  lastExecutedAt      DateTime?
  lastExecutionStatus GitHubAutomationRunStatus?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository          GitHubRepository?             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project             Project?                      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task                Task?                         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy           User                          @relation("GitHubRuleCreator", fields: [createdById], references: [id])
  updatedBy           User?                         @relation("GitHubRuleUpdater", fields: [updatedById], references: [id])
  runs                GitHubAutomationRun[]

  @@index([organizationId, isEnabled])
  @@index([organizationId, repositoryId, triggerEvent])
}

model GitHubAutomationRun {
  id             String                        @id @default(uuid()) @db.Uuid
  organizationId String                        @db.Uuid
  ruleId         String                        @db.Uuid
  eventId        String?                       @db.Uuid
  taskId         String?                       @db.Uuid
  triggerEvent   GitHubAutomationTrigger
  action         GitHubAutomationAction
  targetStatus   TaskStatus?
  status         GitHubAutomationRunStatus     @default(PENDING_APPROVAL)
  executionMode  GitHubAutomationExecutionMode
  explanation    String                        @default("")
  payloadSummary Json                          @default("{}")
  errorMessage   String?
  reviewedById   String?                       @db.Uuid
  reviewedAt     DateTime?
  executedAt     DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           GitHubAutomationRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  event          GitHubEvent?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  task           Task?                         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewedBy     User?                         @relation("GitHubRunReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, taskId])
}

model WorkflowAutomationRule {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  projectId           String?              @db.Uuid
  name                String
  description         String               @default("")
  triggerEvent        WorkflowTriggerType
  action              WorkflowActionType
  conditions          Json                 @default("{}")
  actionConfig        Json                 @default("{}")
  requiresApproval    Boolean              @default(true)
  isEnabled           Boolean              @default(true)
  createdById         String               @db.Uuid
  updatedById         String?              @db.Uuid
  lastExecutedAt      DateTime?
  lastExecutionStatus WorkflowRunStatus?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("WorkflowRuleCreator", fields: [createdById], references: [id])
  updatedBy           User?                @relation("WorkflowRuleUpdater", fields: [updatedById], references: [id])
  runs                WorkflowAutomationRun[]

  @@index([organizationId, isEnabled])
  @@index([organizationId, triggerEvent])
}

model WorkflowAutomationRun {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  ruleId         String               @db.Uuid
  projectId      String?              @db.Uuid
  taskId         String?              @db.Uuid
  milestoneId    String?              @db.Uuid
  triggerEvent   WorkflowTriggerType
  action         WorkflowActionType
  status         WorkflowRunStatus    @default(PENDING_APPROVAL)
  dedupeKey      String?
  explanation    String               @default("")
  proposedAction Json                 @default("{}")
  executionResult Json?
  errorMessage   String?
  reviewedById   String?              @db.Uuid
  reviewedAt     DateTime?
  executedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           WorkflowAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task           Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewedBy     User?                @relation("WorkflowRunReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, dedupeKey])
}

model StorageObject {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  provider       String              @default("local")
  bucket         String?
  storageKey     String              @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  entityType     String              // "MEETING_RECORDING" | "DOCUMENT" | "TRANSCRIPT"
  entityId       String?             @db.Uuid
  uploadStatus   StorageUploadStatus @default(READY)
  lastAccessedAt DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime?
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  holds          FileRetentionHold[]
  recording      MeetingRecording?   @relation("RecordingStorageObject")
  document       Document?           @relation("DocumentStorageObject")

  @@index([organizationId, entityType])
  @@index([organizationId, expiresAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId, sha256])
}

model OrganizationRetentionPolicy {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @unique @db.Uuid
  recordingRetentionDays Int?
  documentRetentionDays  Int?
  autoDeleteExpired      Boolean      @default(false)
  manualDeletionAllowed  Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FileRetentionHold {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  storageObjectId String            @db.Uuid
  reason          String
  holdType        RetentionHoldType @default(LEGAL)
  appliedById     String            @db.Uuid
  appliedAt       DateTime          @default(now())
  releasedById    String?           @db.Uuid
  releasedAt      DateTime?
  releaseReason   String?
  createdAt       DateTime          @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageObject   StorageObject     @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)
  appliedBy       User              @relation("HoldApplier", fields: [appliedById], references: [id])
  releasedBy      User?             @relation("HoldReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([organizationId, storageObjectId])
  @@index([storageObjectId, releasedAt])
}

model GoogleOAuthState {
  stateHash      String       @id
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([organizationId, userId, createdAt])
}

model GoogleConnection {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @unique @db.Uuid
  connectedById          String                @db.Uuid
  googleUserId           String
  googleEmail            String
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  scopes                 String[]              @default([])
  status                 String                @default("CONNECTED") // "CONNECTED" | "NEEDS_REAUTH" | "REVOKED"
  calendarSyncToken      String?
  lastCalendarSyncAt     DateTime?
  calendarSyncStatus     String                @default("IDLE") // "IDLE" | "SYNCING" | "SUCCESS" | "FAILED"
  calendarSyncError      String?
  gmailHistoryId         String?
  lastGmailSyncAt        DateTime?
  gmailSyncStatus        String                @default("IDLE") // "IDLE" | "SYNCING" | "SUCCESS" | "FAILED"
  gmailSyncError         String?
  metadata               Json                  @default("{}")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy            User                  @relation("GoogleConnectionOwner", fields: [connectedById], references: [id])
  calendarEvents         GoogleCalendarEvent[]
  gmailMessages          GmailMessage[]

  @@index([organizationId, status])
}

model GoogleCalendarEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  connectionId       String           @db.Uuid
  googleEventId      String
  summary            String
  description        String?
  location           String?
  startsAt           DateTime
  endsAt             DateTime
  isAllDay           Boolean          @default(false)
  status             String           @default("confirmed") // "confirmed" | "tentative" | "cancelled"
  htmlLink           String?
  attendees          Json             @default("[]")
  creatorEmail       String?
  organizerEmail     String?
  etag               String?
  projectId          String?          @db.Uuid
  meetingId          String?          @db.Uuid
  suggestedProjectId String?          @db.Uuid
  suggestionReason   String?
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection         GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  suggestedProject   Project?         @relation("SuggestedCalendarProject", fields: [suggestedProjectId], references: [id], onDelete: SetNull)
  meeting            Meeting?         @relation("GoogleMeetingLink", fields: [meetingId], references: [id], onDelete: SetNull)

  @@unique([organizationId, googleEventId])
  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
}

model GmailMessage {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  connectionId       String           @db.Uuid
  gmailMessageId     String
  threadId           String?
  subject            String
  from               String
  to                 String?
  date               DateTime?
  snippet            String
  labels             String[]         @default([])
  projectId          String?          @db.Uuid
  suggestedProjectId String?          @db.Uuid
  suggestionReason   String?
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection         GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  suggestedProject   Project?         @relation("SuggestedGmailProject", fields: [suggestedProjectId], references: [id], onDelete: SetNull)

  @@unique([organizationId, gmailMessageId])
  @@index([organizationId, date])
  @@index([organizationId, projectId])
}

model ProjectHealthSnapshot {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  projectId        String       @db.Uuid
  score            Float?
  classification   String       // "HEALTHY" | "AT_RISK" | "CRITICAL" | "INSUFFICIENT_DATA" | "EXCLUDED"
  dimensionScores  Json         // { taskCompletion, deadlinePerformance, blockersAndDependencies, milestonePerformance, recentActivity }
  activeRisksCount Json         // { total, critical, high, medium, low }
  dataCompleteness Float        // 0.0 to 1.0
  forecast         Json?        // { trend, estimatedCompletionDate, remainingWorkload, confidence, reasons }
  algorithmVersion String       @default("1.0.0")
  explanation      String?
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, classification])
}

model ProjectRisk {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  projectId            String       @db.Uuid
  riskType             String
  fingerprint          String
  severity             String       // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  title                String
  explanation          String
  evidence             Json
  recommendedAction    String
  confidence           String       @default("HIGH") // "HIGH" | "MEDIUM" | "LOW"
  affectedTaskIds      String[]     @default([])
  affectedMilestoneIds String[]     @default([])
  status               String       @default("ACTIVE") // "ACTIVE" | "RESOLVED" | "DISMISSED"
  dismissedAt          DateTime?
  dismissedById        String?      @db.Uuid
  dismissReason        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dismissedBy          User?        @relation("RiskDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@unique([projectId, fingerprint])
  @@index([organizationId, projectId, status])
  @@index([organizationId, severity, status])
}

model ProjectWeeklyReport {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  projectId        String       @db.Uuid
  creatorId        String       @db.Uuid
  title            String
  periodStart      DateTime
  periodEnd        DateTime
  status           String       @default("COMPLETED")
  executiveSummary String       @default("")
  metrics          Json         @default("{}")
  progressOverview Json         @default("{}")
  blockersAndRisks Json         @default("{}")
  teamWorkload     Json         @default("[]")
  meetingInsights  Json         @default("{}")
  recommendations  Json         @default("[]")
  pdfStorageKey    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator          User         @relation("ReportCreator", fields: [creatorId], references: [id])

  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, createdAt])
}



